# No API key is required for local stdio use. The server reads process environment variables;
# it does not auto-load .env. official_snapshot also requires TAIWAN_LAB_DATA_DIR.
TAIWAN_LAB_DATA_MODE=sample

# HTTP deployments keep a small request/body guard even on loopback. A public deployment must
# also set TAIWAN_LAB_HTTP_ALLOWED_HOSTS and use official_snapshot mode.
TAIWAN_LAB_HTTP_RATE_LIMIT_PER_MINUTE=240
TAIWAN_LAB_HTTP_MAX_REQUEST_BYTES=262144

# Optional private-deployment authentication. Store only SHA-256(token), never the token itself.
# TAIWAN_LAB_HTTP_BEARER_TOKEN_SHA256=
